<?xml version="1.0" encoding="utf-8"?>
<!-- Language's launcher glyph, as Launcher's: a glossy disc filling the launcher's circle, with Material Symbols'
     "translate" sign, in the user's ivory 3D relief (Modules/icons/language/export.py writes the layers).
     The disc's grey body is multiplied by a tone of the wallpaper's accent, its white rim lights it, untinted,
     and the sign lies on top as drawn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/language_body"
            android:tint="@color/ic_launcher_disc"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/language_shine" />
    <item android:drawable="@drawable/language_sign" />
</layer-list>
